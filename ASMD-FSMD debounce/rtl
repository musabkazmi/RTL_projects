        // Code block for condition1 true and condition2 false
      state_next = wait1;
      q_dec =  1'b1 ;
      q_load =  1'b0 ;
      
    end
end else begin
    // Code block for condition1 false
  state_next = zero;
end
          
        end
        
        //         one  begin
        	one: 	begin
	          		db_level = 1'b1;	
              if (sw==0) begin
						state_next = wait0;
                		q_load =  1'b1 ;
                		q_dec =  1'b0 ;
						end else begin
						state_next = one;
				end
	        			end
//       __________________________
        
        
        //       __________________________
        
//         wait0 begin
        wait0 : begin
          db_level = 1'b1;
          if (sw==0) begin
            
    if (q_next== 0) begin
        // Code block for condition1 and condition2 true
      state_next = zero;
    end else begin
        // Code block for condition1 true and condition2 false
      state_next = wait0;
      q_dec =  1'b1 ;
       q_load =  1'b0 ;
    end
end else begin
    // Code block for condition1 false
  state_next = one;
end
          
        end
        
        
        default:
                state_next = zero;
        
        
       endcase
        end
    
  
