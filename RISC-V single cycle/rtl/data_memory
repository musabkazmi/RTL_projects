module data_memory #(parameter DATA_WIDTH = 32,
parameter NUM_REGS   = 32)
  (input logic clk,
input logic we,
   input logic [31:0] a,
   input logic [DATA_WIDTH -1:0] wd,
   output logic [DATA_WIDTH  -1 :0] rd);
  
  logic [DATA_WIDTH -1:0] dm[NUM_REGS- 1:0];
  logic [$clog2(32)-1:0] word_addr;
  assign word_addr = a[$clog2(32)+1 : 2];


always_ff @(posedge clk)
  begin

  if (we) 
    
      dm[word_addr] <= wd;
  end 

assign   rd = dm[word_addr];
endmodule
