module tick_generator #(
    parameter int unsigned MAX_COUNT = 500_000 - 1
)(
    input  logic clk,
    input  logic reset,
    output logic m_tick
);

    int unsigned count;

    always_ff @(posedge clk) begin
        if (reset) begin
            count  <= 0;
            m_tick <= 1'b0;
        end
        else if (count == MAX_COUNT) begin
            count  <= 0;
            m_tick <= 1'b1;
        end
        else begin
            count  <= count + 1;
            m_tick <= 1'b0;
        end
    end

endmodule

