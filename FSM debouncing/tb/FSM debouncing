`timescale 1ns/1ps

module tb_debounce;

    logic clk;
    logic reset;
    logic sw;
    logic db;


    //========================================================
    // Clock: 10 ns period
    //========================================================

    initial begin
        clk = 0;

        forever #5 clk = ~clk;
    end


    //========================================================
    // DUT
    //========================================================

    debounce #(
        .MAX_COUNT(4)
    ) dut (
        .clk   (clk),
        .reset (reset),
        .sw    (sw),
        .db    (db)
    );


    //========================================================
    // Test
    //========================================================

    initial begin

        $display("========================================");
        $display("Starting debounce test");
        $display("========================================");


        // Initial conditions
        reset = 1;
        sw    = 0;

        repeat (2) @(posedge clk);

        reset = 0;

        $display("[%0t] RESET released", $time);


        //====================================================
        // TEST 1
        //====================================================

        $display("----------------------------------------");
        $display("[%0t] TEST 1: sw = 0", $time);

        repeat (5) @(posedge clk);

        $display("[%0t] sw=%b db=%b", $time, sw, db);


        //====================================================
        // TEST 2
        // Short HIGH glitch
        //====================================================

        $display("----------------------------------------");
        $display("[%0t] TEST 2: short HIGH glitch", $time);

        sw = 1;

        repeat (3) @(posedge clk);

        sw = 0;

        repeat (3) @(posedge clk);

        $display("[%0t] sw=%b db=%b", $time, sw, db);


        //====================================================
        // TEST 3
        // Valid HIGH
        //====================================================

        $display("----------------------------------------");
        $display("[%0t] TEST 3: valid HIGH", $time);

        sw = 1;

        // 3 tick periods
        repeat (20) @(posedge clk);

        $display("[%0t] sw=%b db=%b", $time, sw, db);


        //====================================================
        // TEST 4
        // Short LOW glitch
        //====================================================

        $display("----------------------------------------");
        $display("[%0t] TEST 4: short LOW glitch", $time);

        sw = 0;

        repeat (3) @(posedge clk);

        sw = 1;

        repeat (3) @(posedge clk);

        $display("[%0t] sw=%b db=%b", $time, sw, db);


        //====================================================
        // TEST 5
        // Valid LOW
        //====================================================

        $display("----------------------------------------");
        $display("[%0t] TEST 5: valid LOW", $time);

        sw = 0;

        repeat (20) @(posedge clk);

        $display("[%0t] sw=%b db=%b", $time, sw, db);


        //====================================================
        // Finish
        //====================================================

        $display("----------------------------------------");
        $display("TEST COMPLETE");
        $display("========================================");

        $finish;

    end


    //========================================================
    // Monitor
    //========================================================

    always @(posedge clk) begin
        $display(
            "[%0t] sw=%b m_tick=%b db=%b state=%s",
            $time,
            sw,
            dut.m_tick,
            db,
            dut.state_reg.name()
        );
    end
  initial begin
        $dumpfile("edge_detector.vcd");
        $dumpvars(0, edge_detector_tb);
    end

endmodule
