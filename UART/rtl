module baut_generator
  #(parameter M = 163,
    parameter     N = ($clog2(M))) 
  (
    input  logic clk,
    input  logic reset,  

  	output logic max_tick,
    output logic [N-1:0] q
  );

  logic  [N - 1:0]  r_reg;
  logic  [N - 1:0]  r_next;
  
    always_ff @(posedge clk or posedge reset) begin

        if (reset) begin

            r_reg <= 0;

        end

        else begin

           r_reg <= r_next;

        end

    end
  
   always_comb begin
     
     if (r_reg< M-1)
     	begin
          r_next= r_reg + 1;
        end
     else begin
       	  r_next= 0;
     end
     
     if (r_reg == M-1)
     	begin
         max_tick = 1;
        end
     else begin
       	  max_tick = 0;
     end
   end
  
  assign q= r_reg;
endmodule

