module uart_rx
  #(parameter DBIT = 8,
    parameter SB_TICK    = 16) 
  (
  	input  logic clk,
    input  logic reset,
    input  logic s_tick,
    input  logic rx,
    
    output logic rx_done_tick,
output logic [DBIT-1:0] dout
  
  
  );
  
        //========================================================
    // State declaration
    //========================================================

  typedef enum logic [1:0] {
    	idle,
    	start,
    	data,
    	stop
        
    } state_t;

    state_t state_reg, state_next;
  
  logic [SB_TICK - 1:0] s_reg;
logic [$clog2(DBIT):0] n_reg;
  logic  [DBIT - 1:0] b_reg;
  
  logic [SB_TICK - 1:0]s_next;
  logic [$clog2(DBIT):0] n_next;
  logic  [DBIT - 1:0] b_next;
  
  
    //==========================================================
    // 1. SEQUENTIAL LOGIC for sates/ FSM
    //==========================================================

    always_ff @(posedge clk or posedge reset) begin

        if (reset) begin

            state_reg <= idle;

        end

        else begin

            state_reg <= state_next;

        end

    end  
  
     //==========================================================
    // 1. SEQUENTIAL LOGIC for DATAPATH 
    //==========================================================

    always_ff @(posedge clk or posedge reset) begin
      
      if (reset) begin

          s_reg <= 0;
          n_reg <= 0;
          b_reg <= 0;
          
          
        end
      else begin
		  s_reg <= s_next;
          n_reg <= n_next;
          b_reg <= b_next;
        
      end
      
    end
  
    //========================================================
    // FSM control logic/ next state logic
    //========================================================

    always_comb begin
      
      state_next = state_reg;
      
       case (state_reg)
// -----------------------------         
         idle: begin
           
           if (rx) begin
	       state_next = idle;
			 end
              else begin
            state_next = start;
        end         
     
         end
// ----------------------- 
         
         start: begin
           
           if (s_tick && s_reg == (SB_TICK/2 - 1)) begin
	       state_next = data;
			 end
              else begin
            state_next = start;
        end         
     
         end
// -----------------------  
         data: begin
           
           if (s_tick && s_reg == (SB_TICK - 1) && n_reg == DBIT-1) begin
	       state_next = stop;
			 end
              else begin
            state_next = data;
        end         
     
         end
// -----------------------     
         
         stop: begin
           
           if (s_tick && s_reg == (SB_TICK - 1)) begin
	       state_next = idle;
			 end
              else begin
            state_next = stop;
        end         
     
         end
// -----------------------   
       endcase
      
    end
  
  
      //========================================================
    // next state datapath logic
    //========================================================

    always_comb begin
      rx_done_tick = 0;
      n_next = n_reg;
      s_next = s_reg;
      b_next = b_reg;
      case (state_reg)
        
        idle : begin
          
         s_next = 0;
          n_next = 0;
          
        end
        start : begin
          
          if (s_tick)
            begin
              
              if (s_reg < (SB_TICK/2 - 1))
            begin
              s_next = s_reg + 1;

              
            end              
			else begin
              s_next = 0;
              n_next =0;              
              
			end
//               s_next = s_reg + 1;
            end
         
        end
//         --------
        data: begin
          
          if (s_tick)
            begin
              
              if (s_reg < (SB_TICK - 1))
                begin
                  s_next = s_reg + 1;
                end
              else begin
                b_next = {rx, b_reg[DBIT-1:1]};
                s_next = 0;
                if (n_reg < DBIT-1)
                  n_next = n_reg + 1;
              end
             
                

            end
          
          
        end
//         -----------------------------
        
        stop: begin
        
          if (s_tick)
            begin
              if (s_reg < (SB_TICK - 1))
                s_next = s_reg + 1;
              else begin
                s_next = 0;
                rx_done_tick = 1;
              end
            end
 
        end
        
        
        
        
       endcase
      
      
    end
  
  assign dout = b_reg;
  
  endmodule

