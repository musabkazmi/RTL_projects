module uart_tx
  #(parameter DBIT = 8,
		parameter SB_TICK     = 16) 
  (
    input  logic clk,
    input  logic reset, 
    input  logic tx_start,
    input  logic s_tick,
    input  logic [DBIT-1:0] d_in,
    
    output logic tx_done_tick,
    output logic tx
  );
  
  
      //========================================================
    // State declaration
    //========================================================

  typedef enum logic [1:0] {
    	idle,
    	start,
    	data,
    	stop
        
    } state_t;
  
  state_t state_reg, state_next;
  
  logic [$clog2(SB_TICK):0] s_reg;
  logic [$clog2(DBIT):0] n_reg;
  logic tx_reg;
  logic [DBIT-1:0] d_in_reg;
  
  logic [$clog2(SB_TICK):0] s_next;
  logic [$clog2(DBIT):0] n_next;
  logic [DBIT-1:0] d_in_next;
  
  
      // 1. SEQUENTIAL LOGIC for sates/ FSM
    //==========================================================

    always_ff @(posedge clk or posedge reset) begin

        if (reset) begin

            state_reg <= idle;

        end

        else begin

            state_reg <= state_next;

        end

    end
  
    always_ff @(posedge clk or posedge reset) begin
      
        if (reset) begin

// 			d_in_reg <= d_in;
//           	tx_done_tick <= 0;
//           	tx_reg <= 0;
          	tx <= 1;
          	s_reg <= 0;
          	n_reg <= 0;
          	d_in_reg<=0;
          	
        end
              else begin

            
          	tx <= tx_reg;
            s_reg <= s_next;
            n_reg <= n_next;
                d_in_reg<=d_in_next;

        end
      
    end
  
   //========================================================
    // FSM control logic/ next state logic
    //========================================================

    always_comb begin
      
       state_next = state_reg;
      d_in_next = d_in_reg;
      case(state_reg)
        idle:begin
          if(tx_start)
            begin
              state_next = start;
              d_in_next = d_in;
            end
          else begin
            state_next = idle;
          end
          
        end
		
        start:begin
           if (s_tick) begin
          if (s_reg< SB_TICK - 1)
            begin
              state_next = start;
            end
          else begin
              state_next = data; 
          end
           end
        end
        
        data:begin
           if (s_tick) begin
          if (s_reg == SB_TICK - 1 && n_reg == DBIT-1)
            begin
              state_next = stop;
            end
          else begin
              state_next = data;
                       	
          end 
           end
        end
        
        stop:begin
           if (s_tick) begin
          if (s_reg< SB_TICK - 1)
            begin
              state_next = stop;
            end
          else begin
              state_next = idle;
          end 
             
           end
          
        end
        
        
      endcase
    end

    // next state datapath logic
    //========================================================

    always_comb begin
      tx_done_tick = 0;
      s_next = s_reg;
      n_next = n_reg;
//       d_in_next = d_in_reg;
  	case(state_reg)
      
      idle : begin
        tx_reg=1;
//         s_next= 0;
//         n_next=0;
      end
//       ------------
      start:begin
        tx_reg=0;
        if (s_tick) begin
          
          if (s_reg<SB_TICK- 1)begin
            s_next=s_reg+ 1;
          end
          else begin
			 s_next= 0;
            n_next = 0;
          end
          
        end
//         else begin
//                       s_next= 0;
//         end
        
      end
//       -----------------------
		data:begin
          tx_reg=d_in_reg[n_reg];
          if (s_tick) begin
            if (s_reg < SB_TICK - 1 )
              begin
                s_next=s_reg+ 1;
              end
            else begin
              s_next = 0;
              if (n_reg < DBIT-1)
                n_next = n_reg + 1;
            end
          end
          
        end
      
// ------------------------------------ 
      
      stop:begin
        tx_reg=1;
        if (s_tick) begin
          
          if (s_reg<SB_TICK- 1)begin
            s_next=s_reg+ 1;
          end
          else begin
            s_next= 0;
             tx_done_tick = 1;
            
          end
          
        end        
        
        
      end
      
//       ------------------------------------
      
      
    endcase
        
        end
  endmodule
