module fifo #(
    parameter DATA_WIDTH = 8,
    parameter DEPTH      = 16,
    parameter FWFT       = 0
)(
    input  logic                  clk,
    input  logic                  reset,

    input  logic                  wr_en,
    input  logic                  rd_en,
    input  logic [DATA_WIDTH-1:0] wr_data,

    output logic [DATA_WIDTH-1:0] rd_data,
    output logic                  empty,
    output logic                  full
);

    // ------------------------------------------------------------
    // Calculate required widths
    // ------------------------------------------------------------

    localparam PTR_WIDTH   = (DEPTH <= 1) ? 1 : $clog2(DEPTH);
    localparam COUNT_WIDTH = $clog2(DEPTH + 1);


    // ------------------------------------------------------------
    // FIFO memory
    // ------------------------------------------------------------

    logic [DATA_WIDTH-1:0] mem [0:DEPTH-1];


    // ------------------------------------------------------------
    // Read pointer, write pointer and number of stored elements
    // ------------------------------------------------------------

    logic [PTR_WIDTH-1:0]   wr_ptr;
    logic [PTR_WIDTH-1:0]   rd_ptr;
    logic [COUNT_WIDTH-1:0] count;


    // ------------------------------------------------------------
    // Generate EMPTY and FULL flags
    // ------------------------------------------------------------

    logic [DATA_WIDTH-1:0] rd_data_r;
    assign rd_data = FWFT ? mem[rd_ptr] : rd_data_r;

    assign empty = (count == 0);
    assign full  = (count == DEPTH);


    // ------------------------------------------------------------
    // Sequential FIFO logic
    // ------------------------------------------------------------

    always_ff @(posedge clk or posedge reset) begin

        if (reset) begin

            wr_ptr  <= '0;
            rd_ptr  <= '0;
            count   <= '0;
            rd_data_r <= '0;

        end

        else begin

            // ----------------------------------------------------
            // WRITE
            // ----------------------------------------------------

            if (wr_en && !full) begin

                mem[wr_ptr] <= wr_data;

                if (wr_ptr == DEPTH-1)
                    wr_ptr <= '0;
                else
                    wr_ptr <= wr_ptr + 1'b1;

            end


            // ----------------------------------------------------
            // READ
            // ----------------------------------------------------

            if (rd_en && !empty) begin

                rd_data_r <= mem[rd_ptr];

                if (rd_ptr == DEPTH-1)
                    rd_ptr <= '0;
                else
                    rd_ptr <= rd_ptr + 1'b1;

            end


            // ----------------------------------------------------
            // COUNT
            // ----------------------------------------------------

            case ({wr_en && !full, rd_en && !empty})

                2'b10: begin
                    // Write only
                    count <= count + 1'b1;
                end

                2'b01: begin
                    // Read only
                    count <= count - 1'b1;
                end

                2'b11: begin
                    // Read and write at the same time
                    count <= count;
                end

                2'b00: begin
                    // Nothing happens
                    count <= count;
                end

            endcase

        end

    end

endmodule
